APP_ENV=development
APP_NAME=GENQUANTAA_ADLC
API_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Database Configuration (Attempts MongoDB connection; auto-falls back to embedded persistent storage if MongoDB is offline)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=genquantaa_adlc

# Storage Configuration
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage/uploads
MAX_UPLOAD_SIZE_MB=20

# AI Provider Gateway
LLM_PROVIDER=mock
LLM_MODEL=mock-adlc-agent-v1
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
MAX_AGENT_STEPS=10
MAX_RUN_COST_USD=10.0

# Execution & Demo
DEMO_MODE=true
ENABLE_DEV_AUTH=true
